# SPDX-License-Identifier: GPL-3.0-or-later
#

#
# Wait for mongod, initiate the single-node replica set "rs0" once, and
# wait until this node is the primary. Rocket.Chat needs a replica set.
#

exec 1>&2

for _ in $(seq 1 90); do
    if podman exec mongodb-app mongosh --quiet --eval '
        try { rs.status() } catch (e) {
            rs.initiate({_id: "rs0", members: [{_id: 0, host: "127.0.0.1:27017"}]})
        }
        quit(db.hello().isWritablePrimary ? 0 : 1)' >/dev/null 2>&1; then
        exit 0
    fi
    sleep 2
done
echo "MongoDB replica set rs0 did not become primary" >&2
exit 1
