set -e -o pipefail
exec 1>&2

# Load the MongoDB dump taken by bin/module-dump-state into an empty
# database, using a throwaway MongoDB, then leave the data in the volume.
podman volume create mongodb-data >/dev/null 2>&1 || true
podman run --rm --detach --network=none --name=restore_mongo \
    --volume mongodb-data:/data/db:Z \
    "${MONGO_IMAGE}" mongod --replSet rs0 --bind_ip 127.0.0.1
trap 'podman rm -f restore_mongo >/dev/null 2>&1 || true' EXIT
for _ in $(seq 1 90); do
    podman exec restore_mongo mongosh --quiet --eval '
        try { rs.status() } catch (e) {
            rs.initiate({_id: "rs0", members: [{_id: 0, host: "127.0.0.1:27017"}]})
        }
        quit(db.hello().isWritablePrimary ? 0 : 1)' >/dev/null 2>&1 && break
    sleep 2
done
podman exec --interactive restore_mongo mongorestore --archive --gzip --drop < mongodb.archive.gz
podman stop restore_mongo
rm -f mongodb.archive.gz
