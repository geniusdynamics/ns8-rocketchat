set -e

# Redirect any output to the journal (stderr)
exec 1>&2

# If the control reaches this step, the service can be enabled and started.
# Restart (not just start) to apply changed settings.
systemctl --user enable rocketchat.service
systemctl --user restart rocketchat.service
