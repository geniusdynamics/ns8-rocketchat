import os
import secrets

# Password of the initial Rocket.Chat "admin" user. Secrets must not go
# through agent.set_env(), which stores values in Redis: keep it in a
# private file, included in the module backup and loaded by the unit.
path = os.path.join(os.environ["AGENT_STATE_DIR"], "passwords.env")
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as fp:
    fp.write(f"ADMIN_PASS={secrets.token_hex(16)}\n")
